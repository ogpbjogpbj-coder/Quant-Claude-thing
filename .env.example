# Alpaca API Credentials (LIVE trading)
ALPACA_API_KEY=your_api_key_here
ALPACA_SECRET_KEY=your_secret_key_here
ALPACA_BASE_URL=https://api.alpaca.markets

# Optional: Paper trading (for testing)
# ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Risk parameters
MAX_PORTFOLIO_RISK_PCT=2.0
MAX_POSITION_SIZE_PCT=5.0
MAX_DAILY_LOSS_PCT=3.0
MAX_OPEN_POSITIONS=20

# Trading parameters
TRADING_UNIVERSE=SPY,QQQ,AAPL,MSFT,GOOGL,AMZN,NVDA,META,TSLA,AMD,JPM,V,MA,UNH,JNJ,PG,HD,BAC,XOM,CVX,AVGO,LLY,COST,ABBV,MRK,PEP,TMO,CRM,ADBE,NFLX
REBALANCE_INTERVAL_MINUTES=30
DATA_LOOKBACK_DAYS=120

# Logging
LOG_LEVEL=INFO
